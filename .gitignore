.env
.env.local
.env.*.local

# Production / Builds
dist/
dist-ssr/
*.local
out/
# docs/ TIDAK di-ignore — ini adalah GitHub Pages output directory
# public/ TIDAK di-ignore — ini berisi static assets

# IDE / Editor config
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Metadata
.DS_Store
Thumbs.db

# Capacitor / Android build outputs
android/app/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/*.iml
.gradle/

# Vercel build output (regenerated by Vercel on deploy)
.vercel/

